# Copy to .env and adjust. None of these are required for the sample SQLite run.

# sqlite (default) or postgresql+psycopg2://user:password@localhost:5432/supply_chain
DATABASE_URL=sqlite:///data/processed/supply_chain.db

DATA_DIR=data/raw
PROCESSED_DIR=data/processed
LOG_LEVEL=INFO

# Override YAML defaults if needed
FORECAST_HORIZON=28
MAX_FORECAST_SKUS=40
MIN_HISTORY_DAYS=90
SERVICE_LEVEL=0.95
DEFAULT_LEAD_TIME_DAYS=7
